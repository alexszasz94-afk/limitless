# Copy to .env (never commit .env). On the server, deploy/server-setup.sh writes it for you.
# The password for /admin. Long and random.
ADMIN_PASSPHRASE=change-me
# The posters' timezone: decides when a new "day" starts. A name from
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones, e.g. Europe/London, America/New_York.
TIMEZONE=UTC
# Server only: the web address Caddy serves (HTTPS certificate is automatic).
SITE_ADDRESS=portal.example.com
