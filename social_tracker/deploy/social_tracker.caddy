# Site file for the server's shared Caddy (it runs in Distribution's stack and
# imports /etc/caddy/sites/*.caddy). deploy/pull-deploy.sh installs it as
# /srv/caddy-sites/social_tracker.caddy, with __SITE_ADDRESS__ replaced by the
# address in /etc/social_tracker/site_address, and reloads Caddy when it changes.
__SITE_ADDRESS__ {
	encode zstd gzip
	reverse_proxy social-tracker:3100 {
		# during a redeploy, hold requests up to 30 s instead of failing
		lb_try_duration 30s
		lb_try_interval 500ms
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	log {
		output stdout
		format console
		level WARN
	}
}
