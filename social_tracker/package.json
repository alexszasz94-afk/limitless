{
  "name": "social-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Social tracker: views, posts and followers of every product's accounts (Instagram, TikTok, Facebook) from public data.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
