# Copy to .env (never commit .env). On the server, deploy/server-setup.sh writes it for you.
# The password for the dashboard. Long and random.
TRACKER_PASSPHRASE=change-me
# Apify API key(s): one key, or several separated by commas (tried in order).
# Find yours at https://console.apify.com/settings/integrations
APIFY_TOKENS=
